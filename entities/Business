{
  "name": "Business",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Business name"
    },
    "email": {
      "type": "string",
      "description": "Business email"
    },
    "type": {
      "type": "string",
      "enum": [
        "salon",
        "barbershop",
        "aesthetics_clinic",
        "nail_studio",
        "wellness",
        "other"
      ],
      "description": "Type of business"
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Service categories offered"
    },
    "slug": {
      "type": "string",
      "description": "URL-friendly slug for public booking"
    },
    "employee_count": {
      "type": "number",
      "description": "Number of employees"
    },
    "phone": {
      "type": "string",
      "description": "Business phone/WhatsApp (primary)"
    },
    "phone_ddi": {
      "type": "string",
      "description": "Country dial code for primary phone"
    },
    "phone2": {
      "type": "string",
      "description": "Secondary phone"
    },
    "phone2_ddi": {
      "type": "string",
      "description": "Country dial code for secondary phone"
    },
    "address": {
      "type": "string",
      "description": "Street address"
    },
    "address_number": {
      "type": "string",
      "description": "Street number"
    },
    "address_complement": {
      "type": "string",
      "description": "Complement"
    },
    "address_neighborhood": {
      "type": "string",
      "description": "Neighborhood/bairro"
    },
    "address_city": {
      "type": "string",
      "description": "City"
    },
    "address_state": {
      "type": "string",
      "description": "State/province"
    },
    "address_country": {
      "type": "string",
      "description": "Country"
    },
    "address_zip": {
      "type": "string",
      "description": "ZIP/postal code"
    },
    "address_lat": {
      "type": "number",
      "description": "Latitude"
    },
    "address_lng": {
      "type": "number",
      "description": "Longitude"
    },
    "social_instagram": {
      "type": "string",
      "description": "Instagram handle (without @)"
    },
    "social_youtube": {
      "type": "string",
      "description": "YouTube channel"
    },
    "social_tiktok": {
      "type": "string",
      "description": "TikTok handle"
    },
    "social_facebook": {
      "type": "string",
      "description": "Facebook page"
    },
    "logo_url": {
      "type": "string",
      "description": "Logo URL"
    },
    "onboarding_completed": {
      "type": "boolean",
      "default": false
    },
    "subscription_plan": {
      "type": "string",
      "enum": [
        "free_trial",
        "starter",
        "professional",
        "enterprise"
      ],
      "default": "free_trial"
    },
    "subscription_status": {
      "type": "string",
      "enum": [
        "trial",
        "active",
        "cancelled",
        "expired"
      ],
      "default": "trial"
    },
    "trial_end_date": {
      "type": "string",
      "format": "date"
    },
    "whatsapp_connected": {
      "type": "boolean",
      "default": false
    },
    "booking_page_enabled": {
      "type": "boolean",
      "default": true
    },
    "working_hours": {
      "type": "object",
      "description": "Legacy working hours (open/close) \u2014 use schedule_settings instead"
    },
    "schedule_settings": {
      "type": "object",
      "description": "Advanced schedule config: { interval: number, week_schedule: { monday: [{start, end}], ... } }"
    },
    "owner_email": {
      "type": "string",
      "description": "Owner email"
    },
    "invite_code": {
      "type": "string",
      "description": "Unique invite code for employee self-registration"
    }
  },
  "required": [
    "name",
    "type"
  ]
}